<Window x:Class="PrintAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintAgent" Height="503" Width="1000"
        Icon="favicon.ico"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Ellipse x:Name="StatusIndicator" Width="16" Height="16" Fill="Red" Margin="0,0,10,0"/>
            <TextBlock x:Name="StatusText" Text="Bağlantı Yok" VerticalAlignment="Center" FontWeight="Bold"/>
            <Button x:Name="BtnForceReconnect" Content="Tekrar Bağlan" Margin="15,0,0,0" Padding="10,2" Click="BtnForceReconnect_Click" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox x:Name="ChkMinimizeToTray" Content="Tepsiye Küçült" VerticalAlignment="Center" Margin="0,0,15,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
            <CheckBox x:Name="ChkAutoStart" Content="Otomatik Başlat" VerticalAlignment="Center" Margin="0,0,15,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
            <CheckBox x:Name="ChkShowNotifications" Content="Bildirimleri Göster" VerticalAlignment="Center" Margin="0,0,15,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
            <CheckBox x:Name="ChkPausePrinting" Content="Yazdırmayı Duraklat" VerticalAlignment="Center" Margin="0,0,15,0" Checked="PauseSetting_Changed" Unchecked="PauseSetting_Changed" Foreground="DarkRed" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Hub URL:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtHubUrl" Width="300" VerticalAlignment="Center" Margin="0,0,10,0" Padding="2"/>
            <Button x:Name="BtnSaveHubUrl" Content="Güncelle" Padding="10,2" Click="BtnSaveHubUrl_Click"/>
            <TextBlock x:Name="TxtHubUrlStatus" Text="(Değişikliğin etkili olması için uygulamayı yeniden başlatın)" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0" FontStyle="Italic"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Margin="0,0,10,0">
                <GroupBox.Header>
                    <Grid Width="400">
                        <TextBlock Text="İzin Verilen Yazıcılar" VerticalAlignment="Center"/>
                        <Button x:Name="BtnRefreshPrinters" Content="Yenile" HorizontalAlignment="Right" Padding="10,0" Click="BtnRefreshPrinters_Click"/>
                    </Grid>
                </GroupBox.Header>
                <ListBox x:Name="PrintersListBox" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsAllowed}" Click="PrinterSetting_Changed" VerticalAlignment="Center" ToolTip="{Binding Name}"/>
                                <TextBlock Grid.Column="1" Text="Kopya:" VerticalAlignment="Center" Margin="10,0,5,0" />
                                <TextBox Grid.Column="2" Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" Width="30" VerticalAlignment="Center" TextChanged="PrinterSetting_Changed_Text" />
                                <Button Grid.Column="3" Content="Test" Tag="{Binding Name}" Margin="10,0,0,0" Padding="5,0" Click="BtnTestPrint_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Olay Günlüğü">
                <ListBox x:Name="LogListBox" BorderThickness="0" />
            </GroupBox>
        </Grid>
    </Grid>
</Window>
